<div class="flex flex-col space-y-4 mt-6" data-controller="card-collection">
  <form data-card-collection-target="form" action="" method="post" class="flex items-center space-x-4 w-full">
    <div class="flex items-center space-x-4">
      <label for="card_collection_id" class="text-gray-300 w-1/3">Collection:</label>
      <select data-card-collection-target="select" name="card_collection_id" id="card_collection_id" class="border border-gray-700 bg-gray-900 text-gray-200 rounded-lg p-2 w-full" required>
        <option value="">Choose a collection</option>
        <% current_user.card_collections.each do |collection| %>
          <option value="<%= collection.id %>"><%= collection.name %></option>
        <% end %>
      </select>
    </div>

    <div class="flex items-center space-x-4 w-1/3">
      <label for="card_count" class="text-gray-300">Number of cards:</label>
      <input type="number" name="card_count" value="1" min="1" data-card-collection-target="numberOfCards" class="border border-gray-700 bg-gray-900 text-gray-200 rounded-lg p-2 w-full" required>
    </div>

    <input type="hidden" data-card-collection-target="cardId" value="<%= @card.id %>">
    <button type="submit" data-card-collection-target="submitButton" class="text-white font-semibold py-2 px-4 rounded-lg bg-gray-600" disabled>
      Add card
    </button>
  </form>
</div>
