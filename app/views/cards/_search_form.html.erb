<div data-controller="search-cards">
    <form data-turbo="false" data-search-cards-target="form" action="/" method="get" class="mb-8">
      <div class="flex items-center space-x-4">
        <label for="name" class="text-lg font-medium text-gray-300">
          <img src="/assets/mtg_logo.png" title="mtg_logo" alt="mtg_logo" class="inline-block w-48 h-auto">
        </label>
        <input 
          data-search-cards-target="cardName" 
          type="text" 
          name="name" 
          id="name" 
          value="<%= params[:name] %>" 
          placeholder="Search for Magic cards..." 
          autocomplete="off"
          class="border border-gray-700 bg-gray-900 text-gray-200 rounded-lg p-2 w-full" 
        >
        <button 
          data-search-cards-target="submitButton" 
          type="submit" 
          class="bg-gray-700 text-white font-semibold py-2 px-4 rounded-lg hover:bg-gray-600">
          Search
        </button>
        <button 
          data-search-cards-target="clearButton"
          type="button" 
          class="bg-red-700 text-white font-semibold py-2 px-4 rounded-lg hover:bg-red-600">
          Clear
        </button>
      </div>
      
      <%= render "cards/filters", filters: @filters %>
    </form>
</div>
